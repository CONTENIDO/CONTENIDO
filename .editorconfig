# Top-most EditorConfig file
root = true

# Unix-style newlines
[*.{css,html,js,md,php,sql,tpl,txt,xml,json}]
charset = utf-8
end_of_line = LF

# Indentation
[*.{css,html,js,md,php,sql,tpl,txt,xml}]
indent_size = 4
indent_style = space

# Final new line and trim trailing whitespaces
[*.{css,js,php}]
insert_final_newline = true
trim_trailing_whitespace = true

# composer.json
[{composer.json}]
indent_size = 4
indent_style = space

# .htaccess, .gitignore
[{.htaccess,.gitignore}]
charset = utf-8
end_of_line = LF
indent_size = 4

# .bat files
[*.bat]
end_of_line = CRLF
