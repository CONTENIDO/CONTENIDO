# Normalize all text files to LF in the repository
* text=auto

# Explicitly mark common binary formats (optional, Git detects most automatically)
*.png binary
*.gif binary
*.jpg binary
*.jpeg binary
*.ico binary
*.pdf binary
*.zip binary
*.gz binary
*.tar binary

# Prevent Git from attempting to normalize minified files
*.min.js -text
*.min.css -text

# Ensure shell scripts always use LF
*.sh text eol=lf

# Ensure PHP, JS, CSS, HTML, and config files are treated as text
*.php text
*.js text
*.css text
*.html text
*.htm text
*.json text
*.xml text
*.yml text
*.yaml text
*.ini text
*.txt text
*.md text

# GitHub linguist overrides (optional)
# Example: mark vendor libraries as "generated"
# vendor/** linguist-generated=true

# Exclude internal files from archive exports (optional)
.gitattributes export-ignore
.gitignore export-ignore
.gitmodules export-ignore