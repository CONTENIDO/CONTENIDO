{
    "name": "contenido/contenido",
    "type": "contenido-cms",
    "description": "CONTENIDO CMS",
    "keywords": [
        "CONTENIDO",
        "CMS"
    ],
    "homepage": "https://www.contenido.org",
    "license": ["GPL-2.0"],
    "config": {
        "platform": {
            "php": "7.2"
        },
        "sort-packages": true
    },
    "require-dev": {
        "dealerdirect/phpcodesniffer-composer-installer": "^1.2",
        "phpcompatibility/php-compatibility": "^9.3",
        "phpstan/phpstan": "^1.12",
        "phpunit/phpunit": "^8",
        "rector/rector": "^1.2"
    },
    "require": {
        "ext-bcmath": "*",
        "ext-dom": "*",
        "ext-fileinfo": "*",
        "ext-gd": "*",
        "ext-iconv": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-mysqli": "*",
        "ext-simplexml": "*",
        "ext-zip": "*",
        "ext-libxml": "*",
        "php": ">=7.1"
    }
}
